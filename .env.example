# Rajadhaniyam — environment variables
# Copy to .env and fill in real values. Never commit .env.
#
# Server-only secrets are read by apps/api and packages/database.
# Browser-accessible variables MUST be prefixed with VITE_ (Vite only
# exposes prefixed vars to client code) and are read by apps/storefront
# and apps/admin.

# ---------------------------------------------------------------------------
# Database (packages/database — Supabase Postgres, see packages/database/README.md)
# ---------------------------------------------------------------------------
# Pooled connection (PgBouncer, port 6543) — used by the running app.
# Needs ?pgbouncer=true or every query fails with
# `prepared statement "s0" already exists`.
DATABASE_URL=postgresql://user:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection (port 5432) — required by `prisma migrate` only, since
# the pooler can't create its shadow database.
DIRECT_URL=postgresql://postgres:password@db.PROJECT_REF.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Auth / security secrets (apps/api) — server-only, generate real random values
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-in-every-environment
SESSION_SECRET=change-me-in-every-environment

# ---------------------------------------------------------------------------
# Server (apps/api)
# ---------------------------------------------------------------------------
API_PORT=4000
STOREFRONT_URL=http://localhost:8080
ADMIN_URL=http://localhost:4001

# ---------------------------------------------------------------------------
# Browser-accessible (apps/storefront, apps/admin)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000
VITE_ADMIN_URL=http://localhost:4001

# ---------------------------------------------------------------------------
# Payments — not integrated yet (Phase 9 of docs/DEVELOPMENT_ROADMAP.md)
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
